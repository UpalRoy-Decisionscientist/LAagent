# Optional path to a Playwright storageState JSON captured from a user-owned AWS session.
# The pipeline never asks for passwords and defaults to the local lab replica console.
AWS_STORAGE_STATE=

# Live AWS Console IAM login (operator-owned account only). Leave unset in CI.
# The Playwright agent will not attempt live login unless AWS_E2E_LIVE=1.
AWS_CONSOLE_ACCOUNT_ID=
AWS_CONSOLE_USERNAME=
AWS_CONSOLE_PASSWORD=
# HCP Terraform agents on ECS (aws-ia/terraform-aws-tf-cloud-agents).
# Uses the AWS credential chain / task role. Do not put console passwords here.
TFC_ORG_NAME=
TFC_TOKEN=
TFE_TOKEN=
TFC_AGENT_NAME=laagent-tfc
AWS_REGION=us-west-2
AWS_VPC_ID=
AWS_SUBNET_IDS=
AWS_PROFILE=
AWS_TF_AGENTS_APPLY=0

